    "# ─────────────────────────────────────────────────────────────\n",
    "# SAVE / LOAD AGENT KNOWLEDGE  (optional)\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def save_agent(agent: WordleAgent, path: str = \"wordle_agent.json\"):\n",
    "    data = {\n",
    "        \"games_played\"    : agent.games_played,\n",
    "        \"games_won\"       : agent.games_won,\n",
    "        \"epsilon\"         : agent.epsilon,\n",
    "        \"opener_wins\"     : dict(agent.opener_wins),\n",
    "        \"opener_trials\"   : dict(agent.opener_trials),\n",
    "        \"letter_value\"    : dict(agent.letter_value),\n",
    "        \"pos_letter_wins\" : {str(k): dict(v) for k, v in agent.pos_letter_wins.items()},\n",
    "    }\n",
    "    with open(path, \"w\") as f:\n",
    "        json.dump(data, f, indent=2)\n",
    "    print(f\"✅ Agent saved to {path}  ({agent.games_played:,} games, {agent.win_rate*100:.1f}% win rate)\")\n",
    "\n",
    "\n",
    "def load_agent(word_list: list, path: str = \"wordle_agent.json\") -> WordleAgent:\n",
    "    with open(path) as f:\n",
    "        data = json.load(f)\n",
    "    a = WordleAgent(word_list, epsilon=data[\"epsilon\"])\n",
    "    a.games_played   = data[\"games_played\"]\n",
    "    a.games_won      = data[\"games_won\"]\n",
    "    a.opener_wins    = defaultdict(int, data[\"opener_wins\"])\n",
    "    a.opener_trials  = defaultdict(int, data[\"opener_trials\"])\n",
    "    a.letter_value   = defaultdict(float, data[\"letter_value\"])\n",
    "    for k, v in data[\"pos_letter_wins\"].items():\n",
    "        a.pos_letter_wins[int(k)] = defaultdict(int, v)\n",
    "    print(f\"✅ Agent loaded from {path}  ({a.games_played:,} games)\")\n",
    "    return a\n",
    "\n",
    "\n",
    "# Uncomment to save/load:\n",
    "# save_agent(agent, \"wordle_agent.json\")\n",
    "# agent = load_agent(WORDS, \"wordle_agent.json\")\n",
    "\n",
    "print(\"Save/load functions ready. Uncomment the lines above to persist your trained agent.\")"
