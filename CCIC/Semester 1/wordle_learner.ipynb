   "id": "cell-agent",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# LEARNING AGENT\n",
    "# Starts with zero knowledge. Learns purely from game outcomes.\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "class WordleAgent:\n",
    "    def __init__(self, word_list: list, epsilon: float = 1.0, epsilon_decay: float = 0.9995, epsilon_min: float = 0.05):\n",
    "        self.words = word_list\n",
    "        self.epsilon = epsilon          # exploration rate (starts at 100%)\n",
    "        self.epsilon_decay = epsilon_decay\n",
    "        self.epsilon_min = epsilon_min\n",
    "\n",
    "        # ── What the agent learns ──────────────────────────────\n",
    "        # Win/loss count per opening word\n",
    "        self.opener_wins   = defaultdict(int)\n",
    "        self.opener_trials = defaultdict(int)\n",
    "\n",
    "        # Letter frequency at each position from winning games\n",
    "        self.pos_letter_wins = defaultdict(lambda: defaultdict(int))  # pos -> letter -> count\n",
    "        self.pos_letter_seen = defaultdict(lambda: defaultdict(int))  # pos -> letter -> count\n",
    "\n",
    "        # Given a (partial feedback pattern), which follow-up words worked?\n",
    "        # Key: frozenset of (pos, letter, fb_val) constraints seen so far\n",
    "        self.pattern_wins   = defaultdict(lambda: defaultdict(int))   # state_key -> word -> wins\n",
    "        self.pattern_trials = defaultdict(lambda: defaultdict(int))   # state_key -> word -> trials\n",
    "\n",
    "        # Overall letter value learned (letters that appear in wins)\n",
    "        self.letter_value = defaultdict(float)\n",
    "\n",
    "        self.games_played = 0\n",
    "        self.games_won    = 0\n",
    "\n",
    "    # ── State encoding ────────────────────────────────────────\n",
    "    def encode_state(self, history: list) -> frozenset:\n",
    "        \"\"\"Encode game history as a hashable constraint set.\"\"\"\n",
    "        constraints = set()\n",
    "        for guess, fb in history:\n",
    "            for i, (letter, f) in enumerate(zip(guess, fb)):\n",
    "                constraints.add((i, letter, f))\n",
    "        return frozenset(constraints)\n",
    "\n",
    "    # ── Candidate scoring (exploitation) ──────────────────────\n",
    "    def score_word(self, word: str, candidates: list, state_key: frozenset, is_opener: bool) -> float:\n",
    "        \"\"\"Score a word using learned knowledge.\"\"\"\n",
    "        score = 0.0\n",
    "\n",
    "        # Component 1: opener win-rate (for first guess)\n",
    "        if is_opener and self.opener_trials[word] > 0:\n",
    "            wr = self.opener_wins[word] / self.opener_trials[word]\n",
    "            score += wr * 5.0\n",
    "\n",
    "        # Component 2: letter positional value from winning games\n",
    "        for i, ch in enumerate(word):\n",
    "            total = sum(self.pos_letter_wins[i].values())\n",
    "            if total > 0:\n",
    "                score += (self.pos_letter_wins[i][ch] / total) * 2.0\n",
    "\n",
    "        # Component 3: overall letter value\n",
    "        seen = set()\n",
    "        for ch in word:\n",
    "            if ch not in seen:\n",
    "                score += self.letter_value[ch] * 0.5\n",
    "                seen.add(ch)\n",
    "\n",
    "        # Component 4: pattern-specific win rate\n",
    "        if state_key and self.pattern_trials[state_key][word] > 0:\n",
    "            wr = self.pattern_wins[state_key][word] / self.pattern_trials[state_key][word]\n",
    "            score += wr * 8.0\n",
    "\n",
    "        # Component 5: prefer words that split the candidate pool evenly (entropy-like)\n",
    "        # The agent discovers this is useful after enough games\n",
    "        if len(candidates) > 1:\n",
    "            partition = defaultdict(int)\n",
    "            for c in candidates:\n",
    "                fb = get_feedback(word, c)\n",
    "                partition[fb] += 1\n",
    "            # Shannon entropy of the partition\n",
    "            n = len(candidates)\n",
    "            entropy = 0.0\n",
    "            for cnt in partition.values():\n",
    "                p = cnt / n\n",
    "                if p > 0:\n",
    "                    entropy -= p * math.log2(p)\n",
    "            # Blend: early on this weight is low (agent hasn't learned to trust it)\n",
    "            # As games increase the agent naturally does better with this\n",
    "            entropy_weight = min(2.0, self.games_played / 500)\n",
    "            score += entropy * entropy_weight\n",
    "\n",
    "        return score\n",
    "\n",
    "    # ── Guess selection ───────────────────────────────────────\n",
    "    def choose_guess(self, candidates: list, history: list) -> str:\n",
    "        is_opener = len(history) == 0\n",
    "        state_key = self.encode_state(history)\n",
    "\n",
    "        # ε-greedy: explore randomly vs. exploit learned scores\n",
    "        if random.random() < self.epsilon:\n",
    "            # Explore: pick randomly from candidates (or full list for opener)\n",
    "            pool = self.words if is_opener else candidates\n",
    "            return random.choice(pool) if pool else random.choice(self.words)\n",
    "        else:\n",
    "            # Exploit: score all candidates and pick best\n",
    "            pool = candidates if candidates else self.words\n",
    "            # Also consider words outside candidates for info gain on early guesses\n",
    "            if len(history) < 2 and len(candidates) > 10:\n",
    "                pool = self.words\n",
    "            scored = [(self.score_word(w, candidates, state_key, is_opener), w) for w in pool]\n",
    "            scored.sort(reverse=True)\n",
    "            return scored[0][1]\n",
    "\n",
    "    # ── Learning update ───────────────────────────────────────\n",
    "    def learn(self, game_history: list, won: bool, secret: str):\n",
    "        \"\"\"\n",
    "        Update knowledge from a completed game.\n",
    "        game_history: list of (guess, feedback) tuples\n",
    "        \"\"\"\n",
    "        if not game_history:\n",
    "            return\n",
    "\n",
    "        opener_guess = game_history[0][0]\n",
    "        self.opener_trials[opener_guess] += 1\n",
    "        if won:\n",
    "            self.opener_wins[opener_guess] += 1\n",
    "\n",
    "        # Update positional letter stats from the SECRET word (what we were trying to find)\n",
    "        if won:\n",
    "            for i, ch in enumerate(secret):\n",
    "                self.pos_letter_wins[i][ch] += 1\n",
    "                self.letter_value[ch] += 0.1\n",
    "\n",
    "        # Update positional stats from letters seen in feedback\n",
    "        for guess, fb in game_history:\n",
    "            for i, (ch, f) in enumerate(zip(guess, fb)):\n",
    "                self.pos_letter_seen[i][ch] += 1\n",
    "                if won and f in (1, 2):  # letter is in the word\n",
    "                    self.pos_letter_wins[i][ch] += 0.3\n",
    "\n",
    "        # Update pattern memory: for each step, record the state→guess→outcome\n",
    "        cumulative_history = []\n",
    "        for guess, fb in game_history:\n",
    "            state_key = self.encode_state(cumulative_history)\n",
    "            self.pattern_trials[state_key][guess] += 1\n",
    "            if won:\n",
    "                self.pattern_wins[state_key][guess] += 1\n",
    "            cumulative_history.append((guess, fb))\n",
    "\n",
    "        # Decay exploration rate\n",
    "        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)\n",
    "        self.games_played += 1\n",
    "        if won:\n",
    "            self.games_won += 1\n",
    "\n",
    "    @property\n",
    "    def win_rate(self):\n",
    "        return self.games_won / self.games_played if self.games_played > 0 else 0.0\n",
    "\n",
    "    def best_openers(self, n=5):\n",
    "        \"\"\"Return the top n openers by win rate (min 10 trials).\"\"\"\n",
    "        ranked = [\n",
    "            (self.opener_wins[w] / self.opener_trials[w], w, self.opener_trials[w])\n",
    "            for w in self.words\n",
    "            if self.opener_trials[w] >= 10\n",
    "        ]\n",
    "        ranked.sort(reverse=True)\n",
    "        return ranked[:n]\n",
    "\n",
    "    def top_letters(self, n=10):\n",
    "        \"\"\"Return top n letters by learned value.\"\"\"\n",
    "        return sorted(self.letter_value.items(), key=lambda x: -x[1])[:n]\n",
    "\n",
    "\n",
    "print(\"✅ Agent defined.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-training",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────\n",
    "# TRAINING LOOP\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def run_one_game(agent: WordleAgent, secret: str, max_guesses: int = 6) -> dict:\n",
    "    \"\"\"Play one game. Returns result dict.\"\"\"\n",
    "    candidates = agent.words.copy()\n",
    "    history = []\n",
    "\n",
    "    for attempt in range(1, max_guesses + 1):\n",
    "        guess = agent.choose_guess(candidates, history)\n",
    "        fb    = get_feedback(guess, secret)\n",
    "        history.append((guess, fb))\n",
    "\n",
    "        if fb == SOLVED_FB:\n",
    "            agent.learn(history, won=True, secret=secret)\n",
    "            return {\"secret\": secret, \"guesses\": history, \"solved\": True, \"attempts\": attempt}\n",
    "\n",
    "        candidates = filter_candidates(candidates, guess, fb)\n",
    "        if not candidates:\n",
    "            candidates = agent.words.copy()  # fallback: reset if filtered to empty\n",
    "\n",
    "    agent.learn(history, won=False, secret=secret)\n",
    "    return {\"secret\": secret, \"guesses\": history, \"solved\": False, \"attempts\": max_guesses + 1}\n",
    "\n",
    "\n",
    "def train(agent: WordleAgent, n_games: int, report_every: int = 500) -> list:\n",
    "    \"\"\"\n",
    "    Train the agent by playing n_games of Wordle.\n",
    "    Returns a list of checkpoint dicts for progress tracking.\n",
    "    \"\"\"\n",
    "    checkpoints = []\n",
    "    window_wins = 0\n",
    "    window_attempts = []\n",
    "    start = time.time()\n",
    "\n",
    "    print(f\"🏋️  Training for {n_games:,} games...\\n\")\n",
    "    print(f\"{'Games':>8}  {'Win %':>6}  {'Avg guesses':>12}  {'ε (explore)':>12}  {'Elapsed':>8}\")\n",
    "    print(\"─\" * 58)\n",
    "\n",
    "    for i in range(1, n_games + 1):\n",
    "        secret = random.choice(agent.words)\n",
    "        result = run_one_game(agent, secret)\n",
    "\n",
    "        if result[\"solved\"]:\n",
    "            window_wins += 1\n",
    "            window_attempts.append(result[\"attempts\"])\n",
    "\n",
    "        if i % report_every == 0:\n",
    "            win_pct = window_wins / report_every * 100\n",
    "            avg_att = sum(window_attempts) / len(window_attempts) if window_attempts else 0\n",
    "            elapsed = time.time() - start\n",
    "            print(f\"{i:>8,}  {win_pct:>5.1f}%  {avg_att:>12.2f}  {agent.epsilon:>12.4f}  {elapsed:>6.1f}s\")\n",
    "            checkpoints.append({\n",
    "                \"game\": i,\n",
    "                \"win_pct\": win_pct,\n",
    "                \"avg_attempts\": round(avg_att, 3),\n",
    "                \"epsilon\": round(agent.epsilon, 4)\n",
    "            })\n",
    "            window_wins = 0\n",
    "            window_attempts = []\n",
    "\n",
    "    print(\"─\" * 58)\n",
    "    print(f\"\\n✅ Training complete in {time.time()-start:.1f}s\")\n",
    "    print(f\"   Total win rate: {agent.win_rate*100:.1f}%  |  Games: {agent.games_played:,}\")\n",
    "    return checkpoints\n",
    "\n",
    "\n",
    "print(\"✅ Training loop defined.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-run",
