    "# ─────────────────────────────────────────────────────────────\n",
    "# WATCH THE TRAINED AGENT PLAY\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "ICONS = {2: \"🟩\", 1: \"🟨\", 0: \"⬛\"}\n",
    "\n",
    "def watch_game(agent: WordleAgent, secret: str = None, max_guesses: int = 6):\n",
    "    \"\"\"Play one game with full verbose output.\"\"\"\n",
    "    if secret is None:\n",
    "        secret = random.choice(agent.words)\n",
    "    secret = secret.upper()\n",
    "\n",
    "    print(f\"\\n{'═'*40}\")\n",
    "    print(f\"  SECRET: {'?' * 5}  (revealed at end)\")\n",
    "    print(f\"{'═'*40}\")\n",
    "\n",
    "    candidates = agent.words.copy()\n",
    "    history = []\n",
    "    # Force exploitation for demo (set epsilon=0 temporarily)\n",
    "    saved_eps = agent.epsilon\n",
    "    agent.epsilon = 0.0\n",
    "\n",
    "    for attempt in range(1, max_guesses + 1):\n",
    "        guess = agent.choose_guess(candidates, history)\n",
    "        fb    = get_feedback(guess, secret)\n",
    "        history.append((guess, fb))\n",
    "\n",
    "        icons = \"\".join(ICONS[f] for f in fb)\n",
    "        print(f\"  Guess {attempt}: {' '.join(guess)}  {icons}  ({len(candidates)} candidates remaining)\")\n",
    "\n",
    "        if fb == SOLVED_FB:\n",
    "            print(f\"\\n🎉 Solved in {attempt} guess{'es' if attempt > 1 else ''}! Word: {secret}\")\n",
    "            agent.epsilon = saved_eps\n",
    "            return True\n",
    "\n",
    "        candidates = filter_candidates(candidates, guess, fb)\n",
    "        if not candidates:\n",
    "            candidates = agent.words.copy()\n",
    "\n",
    "    print(f\"\\n❌ Failed. The word was: {secret}\")\n",
    "    agent.epsilon = saved_eps\n",
    "    return False\n",
    "\n",
    "\n",
    "# Watch 5 games\n",
    "print(\"Watching 5 games with the trained agent (exploitation mode)...\")\n",
    "wins = sum(1 for _ in range(5) if watch_game(agent))\n",
    "print(f\"\\n✅ Won {wins}/5 demo games.\")"
