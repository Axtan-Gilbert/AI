    "print(\"Running full benchmark (exploitation mode, all words)...\")\n",
    "\n",
    "saved_eps = agent.epsilon\n",
    "agent.epsilon = 0.0  # pure exploitation\n",
    "\n",
    "results = []\n",
    "for word in WORDS:\n",
    "    candidates = agent.words.copy()\n",
    "    history = []\n",
    "    solved = False\n",
    "    for attempt in range(1, 7):\n",
    "        guess = agent.choose_guess(candidates, history)\n",
    "        fb    = get_feedback(guess, word)\n",
    "        history.append((guess, fb))\n",
    "        if fb == SOLVED_FB:\n",
    "            solved = True\n",
    "            break\n",
    "        candidates = filter_candidates(candidates, guess, fb)\n",
    "        if not candidates:\n",
    "            candidates = agent.words.copy()\n",
    "    results.append({\"word\": word, \"solved\": solved, \"attempts\": len(history)})\n",
    "\n",
    "agent.epsilon = saved_eps\n",
    "\n",
    "solved_results = [r for r in results if r[\"solved\"]]\n",
    "win_rate   = len(solved_results) / len(results) * 100\n",
    "avg_att    = sum(r[\"attempts\"] for r in solved_results) / len(solved_results) if solved_results else 0\n",
    "dist       = Counter(r[\"attempts\"] for r in solved_results)\n",
    "hard_words = [r[\"word\"] for r in results if not r[\"solved\"]]\n",
    "\n",
    "print(f\"\\n{'═'*40}\")\n",
    "print(f\"  BENCHMARK RESULTS ({len(WORDS)} words)\")\n",
