    "# ─────────────────────────────────────────────────────────────\n",
    "# WORDLE ENVIRONMENT\n",
    "# The agent interacts with this — it gets feedback, nothing more.\n",
    "# ─────────────────────────────────────────────────────────────\n",
    "\n",
    "def get_feedback(guess: str, secret: str) -> tuple:\n",
    "    \"\"\"Return feedback tuple: 2=correct, 1=present, 0=absent.\"\"\"\n",
    "    fb = [0] * 5\n",
    "    secret_list = list(secret)\n",
    "    used = [False] * 5\n",
    "    for i in range(5):\n",
    "        if guess[i] == secret[i]:\n",
    "            fb[i] = 2\n",
    "            used[i] = True\n",
    "    for i in range(5):\n",
    "        if fb[i] == 2:\n",
    "            continue\n",
    "        for j in range(5):\n",
    "            if not used[j] and guess[i] == secret_list[j]:\n",
    "                fb[i] = 1\n",
    "                used[j] = True\n",
    "                break\n",
    "    return tuple(fb)\n",
    "\n",
    "\n",
    "def is_consistent(word: str, guess: str, feedback: tuple) -> bool:\n",
    "    \"\"\"Check if `word` is consistent with the given guess+feedback.\"\"\"\n",
    "    return get_feedback(guess, word) == feedback\n",
    "\n",
    "\n",
    "def filter_candidates(candidates: list, guess: str, feedback: tuple) -> list:\n",
    "    \"\"\"Narrow down candidate words given a guess and its feedback.\"\"\"\n",
    "    return [w for w in candidates if is_consistent(w, guess, feedback)]\n",
    "\n",
    "\n",
    "SOLVED_FB = (2, 2, 2, 2, 2)\n",
    "\n",
    "print(\"✅ Environment ready.\")"
   ]
